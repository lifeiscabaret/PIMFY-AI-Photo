FROM pytorch/pytorch:2.1.0-cuda12.1-cudnn8-devel

ENV DEBIAN_FRONTEND=noninteractive

# 시스템 패키지 설치
RUN apt-get update && apt-get install -y --no-install-recommends \
    git libgl1-mesa-glx libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 🔥 핵심: pytree 에러를 해결하는 황금 버전 조합
# transformers 4.34.0 버전이 torch 2.1.0과 가장 잘 맞습니다.
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    diffusers==0.21.4 \
    transformers==4.34.0 \
    accelerate==0.23.0 \
    huggingface-hub==0.17.3 \
    fastapi uvicorn pydantic==1.10.11 python-multipart Pillow numpy

# 소스 파일 복사
COPY . .

# 실행 (경로 문제 방지를 위해 절대 경로 사용)
CMD ["python3", "backend/sdxl_server.py"]
